<?xml version="1.0"?><component><view name="touch_calibration_overlay"
        extends="overlay_panel" title="Touch Calibration" title_tag="Touch Calibration" bg_color="#screen_bg"
        back_button_callback="on_touch_cal_back_clicked"><lv_obj name="calibration_content" width="100%" flex_grow="1" style_pad_all="0" scrollable="false" clickable="true"><event_cb trigger="pressed" callback="on_touch_cal_overlay_touched"/><event_cb trigger="released" callback="on_touch_cal_overlay_released"/><event_cb trigger="long_pressed_repeat" callback="on_touch_cal_hold_abort"/><text_body name="instruction_label"
                 width="100%" bind_text="touch_cal_instruction" style_text_align="center" style_pad_top="#space_xl"
                 style_pad_left="#space_lg" style_pad_right="#space_lg"/><lv_label name="crosshair"
                width="50" height="50" text="#icon_target" style_text_font="mdi_icons_48" style_text_color="#primary"
                style_text_align="center" align="top_left"><bind_flag_if cond="touch_cal_state lt 1 or touch_cal_state gt 3" flag="hidden"/></lv_label><lv_obj name="touch_capture_overlay" width="100%" height="100%" align="top_left" clickable="true"><event_cb trigger="pressed" callback="on_touch_cal_overlay_touched"/><event_cb trigger="released" callback="on_touch_cal_overlay_released"/><event_cb trigger="long_pressed_repeat" callback="on_touch_cal_hold_abort"/><bind_flag_if cond="touch_cal_state gt 3" flag="hidden"/></lv_obj><lv_obj name="button_container"
              width="content" height="content" align="bottom_mid" style_pad_bottom="#space_xl" flex_flow="row"
              style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_md"
              scrollable="false"><ui_button name="btn_accept" width="150" text="Accept" translation_tag="Accept"><event_cb trigger="clicked" callback="on_touch_cal_accept_clicked"/><bind_flag_if_not_eq subject="touch_cal_state" flag="hidden" ref_value="4"/></ui_button><ui_button name="btn_retry" width="150" variant="secondary" text="Retry" translation_tag="Retry"><event_cb trigger="clicked" callback="on_touch_cal_retry_clicked"/><bind_flag_if_not_eq subject="touch_cal_state" flag="hidden" ref_value="4"/></ui_button></lv_obj><text_small name="hold_hint"
                  width="content" text="Hold anywhere to cancel" translation_tag="Hold anywhere to cancel"
                  style_text_color="#text_muted" style_text_align="right" align="bottom_right"
                  style_pad_right="#space_md" style_pad_bottom="#space_md"><bind_flag_if cond="touch_cal_state lt 1 or touch_cal_state gt 3" flag="hidden"/></text_small><ui_button name="cancel_chip" width="content" variant="secondary" text="Cancel" translation_tag="Cancel"><event_cb trigger="clicked" callback="on_touch_cal_cancel_clicked"/><bind_flag_if cond="touch_cal_state lt 1 or touch_cal_state gt 3" flag="hidden"/></ui_button></lv_obj></view></component>
