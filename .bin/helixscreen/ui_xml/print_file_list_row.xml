              clickable="false"><text_small name="status_success_count" text="" style_pad_all="0" clickable="false"/><icon name="status_success_icon" src="check" size="xs" variant="success" style_translate_y="-2"/></lv_obj><icon name="status_failed" src="alert" size="xs" variant="danger" style_translate_y="-2" hidden="true"/><icon name="status_cancelled" src="cancel" size="xs" variant="warning" style_translate_y="-2" hidden="true"/></lv_obj><text_small name="row_size"
