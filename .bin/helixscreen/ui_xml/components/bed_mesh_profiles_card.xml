<?xml version="1.0"?><component><styles><style name="profile_row_active"
           bg_opa="255" bg_color="#elevated_bg" border_width="1" border_color="#primary" border_opa="180"/></styles><view name="profiles_card"
        extends="ui_card" width="100%" flex_grow="1" style_border_width="0" style_pad_all="0" flex_flow="column"
        style_min_height="90" scrollable="false"><lv_obj name="profiles_card_header"
            width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_left="#space_md"
            style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_pad_gap="#space_sm"
            scrollable="false"><icon src="layers" size="sm" variant="success"/><text_body text="Profiles" translation_tag="Profiles" flex_grow="1"/></lv_obj><divider_horizontal/><lv_obj name="profiles_list"
            width="100%" flex_grow="1" flex_flow="column" style_pad_all="#space_sm" style_pad_gap="#space_xs"
            scrollable="true"><repeat count="5"><ui_card name="profile_row_${i}"
                 width="100%" height="#bed_mesh_profile_row_height" flex_flow="row" style_flex_cross_place="center"
                 style_flex_track_place="center" style_border_width="0" style_pad_left="#space_sm"
                 style_pad_right="#space_sm" style_pad_top="0" style_pad_bottom="0" style_pad_gap="#space_xs"
                 clickable="true" scrollable="false"><bind_flag_if_lt subject="bed_mesh_profile_count" flag="hidden" ref_value="${i + 1}"/><bind_style_if_eq name="profile_row_active" subject="bed_mesh_profile_${i}_active" ref_value="1"/><event_cb trigger="clicked" callback="on_profile_${i}_clicked"/><text_small name="profile_${i}_name"
                      width="1" height="content" bind_text="bed_mesh_profile_${i}_name" flex_grow="1"
                      style_text_color="#text" clickable="false" long_mode="dots" scrollable="false" event_bubble="true"/><text_small name="profile_${i}_range"
                      width="50" bind_text="bed_mesh_profile_${i}_range" style_text_align="right" clickable="false"
                      event_bubble="true"/><icon name="profile_${i}_rename"
                src="pencil" size="sm" color="#success" clickable="true" style_pad_all="#space_xs"><bind_flag_if_eq subject="bed_mesh_profile_${i}_active" flag="hidden" ref_value="0"/><event_cb trigger="clicked" callback="on_profile_${i}_rename"/></icon><icon name="profile_${i}_load"
                src="arrow_up_circle" size="sm" variant="muted" clickable="true" style_pad_all="#space_xs"><bind_flag_if_eq subject="bed_mesh_profile_${i}_active" flag="hidden" ref_value="1"/><event_cb trigger="clicked" callback="on_profile_${i}_clicked"/></icon><icon name="profile_${i}_delete"
                src="trash_can_outline" size="sm" variant="danger" clickable="true" style_pad_all="#space_xs"><event_cb trigger="clicked" callback="on_profile_${i}_delete"/></icon></ui_card></repeat><lv_obj name="no_profiles_message" width="100%" height="content" style_pad_all="#space_md" scrollable="false"><bind_flag_if_gt subject="bed_mesh_profile_count" flag="hidden" ref_value="0"/><text_small width="100%"
                    text="No profiles available" translation_tag="No profiles available" style_text_align="center"/></lv_obj></lv_obj></view></component>
