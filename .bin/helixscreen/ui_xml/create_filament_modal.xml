            style_pad_gap="#space_sm"><text_heading width="100%"
                    text="Create New Filament" translation_tag="Create New Filament" style_text_align="center"/><lv_obj width="100%"
              height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xs"
              style_flex_cross_place="center" scrollable="false"><text_small text="Vendor:" translation_tag="Vendor:" style_text_color="#text_muted"/><text_small name="modal_vendor_name" bind_text="wizard_selected_vendor_name"/></lv_obj><lv_obj width="100%"
