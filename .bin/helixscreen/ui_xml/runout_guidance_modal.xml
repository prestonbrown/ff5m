<?xml version="1.0"?><component><api><prop name="title" type="string" default="Filament Runout"/><prop name="message"
          type="string"
          default="The printer isn't detecting that any filament is currently loaded. What would you like to do?"/></api><styles><style name="resume_accent" border_color="#primary" border_width="2" border_opa="255"/></styles><view name="runout_guidance_modal"
        extends="ui_dialog" width="80%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0"><lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_sm" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"><icon name="icon_warning" src="alert" size="md" variant="warning"/><text_heading name="dialog_title" text="$title" translation_tag="$title" style_text_align="left" flex_grow="1"/></lv_obj><lv_obj name="content_container"
            width="100%" height="content" style_min_height="40" style_max_height="200" style_pad_left="#space_lg"
            style_pad_right="#space_lg" style_pad_top="0" style_pad_bottom="#space_sm" flex_flow="column"
            style_pad_gap="0"><text_body name="dialog_message"
                 width="100%" text="$message" translation_tag="$message" style_text_align="left" long_mode="wrap"><bind_flag_if_eq subject="runout_autofeed_capable" flag="hidden" ref_value="1"/></text_body><text_body name="dialog_message_autofeed"
                 width="100%" text="Refill the spool, then Resume." translation_tag="Refill the spool, then Resume."
                 style_text_align="left" long_mode="wrap"><bind_flag_if_not_eq subject="runout_autofeed_capable" flag="hidden" ref_value="1"/></text_body></lv_obj><lv_obj name="manual_section_header"
            width="100%" height="content" hidden="true" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="0" style_pad_bottom="0" style_pad_gap="0" flex_flow="column"><text_small name="manual_label"
                  text="Manual" translation_tag="Manual" style_text_color="#text_muted" style_text_align="left"/></lv_obj><lv_obj name="manual_action_row"
            width="100%" height="content" style_pad_all="#space_lg" style_pad_top="#space_sm" flex_flow="row"
            style_flex_main_place="space_between" style_pad_gap="#space_sm"><bind_flag_if_eq subject="runout_autofeed_capable" flag="hidden" ref_value="1"/><ui_button name="btn_load_filament" flex_grow="1" icon="arrow_down" text="Load" translation_tag="Load"/><ui_button name="btn_unload_filament" flex_grow="1" icon="arrow_up" text="Unload" translation_tag="Unload"/><ui_button name="btn_purge" flex_grow="1" icon="filament" text="Purge" translation_tag="Purge"/></lv_obj><divider_horizontal/><lv_obj width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row"><bind_flag_if_eq subject="print_state_enum" flag="hidden" ref_value="2"/><ui_button name="btn_ok" height="100%" flex_grow="1" style_radius="0" text="Close" translation_tag="Close"/></lv_obj><lv_obj width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row"><bind_flag_if_not_eq subject="print_state_enum" flag="hidden" ref_value="2"/><ui_button name="btn_cancel_print"
                 height="100%" flex_grow="1" style_radius="0" variant="danger" text="Cancel Print"
                 translation_tag="Cancel Print"/><divider_vertical/><ui_button name="btn_resume"
                 height="100%" flex_grow="1" style_radius="0" text="Resume Print" translation_tag="Resume Print"><bind_style name="resume_accent" subject="runout_autofeed_capable" ref_value="1"/><bind_state_if_eq subject="runout_resume_blocked" state="disabled" ref_value="1"/></ui_button></lv_obj></view></component>
