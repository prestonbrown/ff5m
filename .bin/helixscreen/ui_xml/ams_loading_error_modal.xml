<?xml version="1.0"?><component><view name="ams_loading_error_modal"
        extends="ui_dialog" width="70%" height="content" style_min_width="300" style_max_width="400"
        style_max_height="85%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0"
        scrollable="false"><modal_header icon_src="alert_circle"
                  icon_variant="danger" title="Loading Error" title_tag="Loading Error" hide_close="false"/><divider_horizontal/><lv_obj name="ams_error_text_scroll"
            width="100%" height="content" style_max_height="#dialog_content_pinned_max" style_pad_left="#space_lg"
            style_pad_right="#space_lg" style_pad_top="#space_lg" style_pad_bottom="#space_md" flex_flow="column"
            style_pad_gap="#space_md" scrollable="true" scroll_snap_y="none"><text_body name="error_message"
                 width="100%" text="An error occurred while loading filament."
                 translation_tag="An error occurred while loading filament." long_mode="wrap"/><text_small name="error_hint"
                  width="100%" text="Check the filament path and try again."
                  translation_tag="Check the filament path and try again." style_text_color="#text_muted"
                  long_mode="wrap"/></lv_obj><lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="0"
            style_pad_bottom="#space_lg" style_bg_opa="0" style_border_width="0" scrollable="false"><bind_flag_if_eq subject="afc_fault_segment" flag="hidden" ref_value="0"/><afc_fault_path name="fault_path"/></lv_obj><modal_button_row secondary_text="Close"
                      secondary_callback="on_modal_cancel_clicked" primary_text="Retry"
                      primary_callback="on_modal_ok_clicked"/></view></component>
