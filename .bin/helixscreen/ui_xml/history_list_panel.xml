<?xml version="1.0"?><component><styles><style name="filter_active" text_color="#primary"/><style name="filter_inactive" text_color="#text"/></styles><view name="history_list_panel"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" flex_flow="column"
        style_pad_all="0" style_bg_opa="255" style_bg_color="#card_bg" style_radius="0" style_border_width="0"><header_bar name="header" title="Print History" title_tag="Print History"/><lv_obj name="filter_row"
            width="100%" height="content" flex_flow="column" style_flex_cross_place="center" scrollable="false"
            style_pad_row="#space_sm" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_sm"
            style_pad_bottom="#space_sm"><bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/><lv_obj name="search_row"
              width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
              style_pad_all="0" scrollable="false"><text_input name="search_box"
                    placeholder_text="Search filename..." placeholder_tag="Search filename..."
                    translation_tag="Search filename..." flex_grow="1" style_max_height="#input_height"
                    show_clear_button="true" clear_callback="history_search_clear"><event_cb trigger="value_changed" callback="history_search_changed"/></text_input><ui_button name="filter_toggle"
                   width="#input_height" height="100%" variant="secondary" style_pad_all="0" clickable="true"
                   flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center"
                   style_flex_track_place="center"><event_cb trigger="clicked" callback="history_filters_toggle"/><icon name="filter_icon" src="filter" size="sm" clickable="false" event_bubble="true"><bind_style name="filter_active" subject="history_filter_active" ref_value="1"/><bind_style name="filter_inactive" subject="history_filter_active" ref_value="0"/></icon></ui_button></lv_obj><lv_obj name="filter_dropdowns"
              width="100%" height="content" flex_flow="row" style_pad_gap="#space_md" style_pad_all="0"
              scrollable="false"><bind_flag_if_eq subject="history_filters_expanded" flag="hidden" ref_value="0"/><lv_dropdown name="filter_status"
                     options="All&#10;Completed&#10;Failed&#10;Cancelled"
                     options_tag="All&#10;Completed&#10;Failed&#10;Cancelled" flex_grow="1"><event_cb trigger="value_changed" callback="history_filter_status_changed"/></lv_dropdown><lv_dropdown name="sort_dropdown"
                     options="Date (newest)&#10;Date (oldest)&#10;Duration&#10;Filename"
                     options_tag="Date (newest)&#10;Date (oldest)&#10;Duration&#10;Filename" flex_grow="1"><event_cb trigger="value_changed" callback="history_sort_changed"/></lv_dropdown></lv_obj></lv_obj><lv_obj name="list_content"
            width="100%" height="content" flex_grow="1" flex_flow="column" style_pad_top="#space_sm"
            style_pad_bottom="#space_md" style_pad_left="#space_md" style_pad_right="#space_md"
            style_pad_row="#space_sm" scrollable="true"><bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/><lv_obj name="loading_state"
              width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_row="#space_md" style_pad_all="#space_xl"><bind_flag_if_not_eq subject="history_list_panel_state" flag="hidden" ref_value="0"/><lv_spinner name="loading_spinner" width="#spinner_lg" height="#spinner_lg"/><text_muted text="Loading history..." translation_tag="Loading history..." style_text_align="center"/></lv_obj><lv_obj name="empty_state"
              width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_row="#space_md" style_pad_all="#space_xl"><bind_flag_if_not_eq subject="history_list_panel_state" flag="hidden" ref_value="1"/><lv_label name="empty_icon" text="󰅐" style_text_font="mdi_icons_48" style_text_color="#text_muted"/><text_muted name="empty_message" bind_text="history_empty_message" style_text_align="center"/><text_small name="empty_hint"
                    bind_text="history_empty_hint" style_text_color="#text_muted" style_text_align="center"/></lv_obj><lv_obj name="list_rows"
              width="100%" height="content" flex_flow="column" style_pad_row="#space_sm" style_pad_all="0"
              clickable="false"><bind_flag_if_not_eq subject="history_list_panel_state" flag="hidden" ref_value="2"/></lv_obj></lv_obj></view></component>
