<?xml version="1.0"?><component><view name="klipper_recovery_card"
        extends="ui_dialog" width="85%" height="content" style_max_height="85%" align="center" flex_flow="column"
        style_flex_main_place="start" style_pad_gap="0" style_border_width="2" style_border_color="#warning"
        scrollable="false"><lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_md" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
            scrollable="false"><icon src="alert_octagon" size="md" variant="warning"/><text_heading name="recovery_title" bind_text="recovery_title" flex_grow="1"/><text_small name="recovery_code" bind_text="recovery_code" style_text_color="#text_muted"><bind_flag_if_eq subject="recovery_has_code" flag="hidden" ref_value="0"/></text_small></lv_obj><divider_horizontal/><lv_obj name="recovery_message_scroll"
            width="100%" height="content" style_max_height="#dialog_content_tall_chrome_max" style_pad_left="#space_lg"
            style_pad_right="#space_lg" style_pad_top="#space_md" style_pad_bottom="#space_md" scrollable="true"
            scroll_snap_y="none"><text_muted name="recovery_message" width="100%" bind_text="recovery_message" long_mode="wrap"/></lv_obj><lv_obj name="recovery_restart_actions"
            width="100%" height="content" style_pad_all="0" style_pad_gap="0" style_bg_opa="0" style_border_width="0"
            scrollable="false"><bind_flag_if_eq subject="recovery_can_restart" flag="hidden" ref_value="0"/><modal_button_row secondary_text="Firmware Restart"
                        secondary_tag="Firmware Restart" secondary_icon="update"
                        secondary_callback="recovery_firmware_restart_clicked" primary_text="Restart Klipper"
                        primary_tag="Restart Klipper" primary_icon="refresh" primary_variant="warning"
                        primary_callback="recovery_restart_klipper_clicked"/></lv_obj><divider_horizontal/><ui_button name="recovery_dismiss_btn"
               width="100%" height="#button_height" variant="ghost" style_radius="0" style_border_width="0"
               focusable="false" text="Dismiss" translation_tag="Dismiss"><event_cb trigger="clicked" callback="recovery_dismiss_clicked"/></ui_button></view></component>
