<?xml version="1.0"?><component><view name="settings_plugins_overlay"
        extends="overlay_panel" title="Plugins" title_tag="Plugins" bg_color="#screen_bg"><lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_lg" scrollable="true" flex_flow="column"
            style_pad_gap="#space_md"><ui_card name="status_card"
               width="100%" height="content" style_border_width="0" style_pad_all="#space_lg" scrollable="false"
               flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md"><lv_obj name="status_icon_container"
                width="#icon_badge_size" height="#icon_badge_size" style_bg_color="#primary" style_bg_opa="255"
                style_radius="#icon_badge_radius" scrollable="false" style_pad_all="0" flex_flow="column"
                style_flex_main_place="center" style_flex_cross_place="center"><icon name="status_icon" src="puzzle_outline" size="md" variant="text"/></lv_obj><lv_obj height="content"
                style_pad_all="0" scrollable="false" flex_flow="column" style_pad_gap="#space_xs" flex_grow="1"><text_heading name="status_title" bind_text="plugins_status_title"/><text_small name="status_detail" bind_text="plugins_status_detail"/></lv_obj></ui_card><lv_obj name="loaded_section"
              width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
              style_pad_gap="#space_sm"><bind_flag_if_eq subject="plugins_loaded_count" flag="hidden" ref_value="0"/><setting_section_header title="LOADED" title_tag="LOADED" icon="check_circle"/><lv_obj name="loaded_plugins_list"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="#space_sm"></lv_obj></lv_obj><lv_obj name="disabled_section"
              width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
              style_pad_gap="#space_sm"><bind_flag_if_eq subject="plugins_disabled_count" flag="hidden" ref_value="0"/><setting_section_header title="DISABLED" title_tag="DISABLED" icon="pause"/><lv_obj name="disabled_plugins_list"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="#space_sm"></lv_obj></lv_obj><lv_obj name="failed_section"
              width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
              style_pad_gap="#space_sm"><bind_flag_if_eq subject="plugins_failed_count" flag="hidden" ref_value="0"/><setting_section_header title="FAILED" title_tag="FAILED" icon="alert_octagon"/><lv_obj name="failed_plugins_list"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="#space_sm"></lv_obj></lv_obj><lv_obj name="no_plugins_message"
              width="100%" height="content" style_pad_all="#space_xl" scrollable="false" flex_flow="column"
              style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_md"><bind_flag_if_not_eq subject="plugins_total_count" flag="hidden" ref_value="0"/><icon src="puzzle_outline" size="lg" variant="secondary"/><text_body text="No plugins found" translation_tag="No plugins found"/><text_small text="Place plugins in the plugins directory to extend HelixScreen"
                    translation_tag="Place plugins in the plugins directory to extend HelixScreen"
                    style_text_color="#text_muted" style_text_align="center"/></lv_obj><info_note icon="info"
                 text="Plugins are discovered on application startup"
                 translation_tag="Plugins are discovered on application startup"/></lv_obj></view></component>
