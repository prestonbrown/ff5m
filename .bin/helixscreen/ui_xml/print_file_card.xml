                style_flex_cross_place="center" clickable="false" event_bubble="true"><icon src="weight" size="xs" variant="primary"/><text_xs name="filament_label" text="$filament_weight" flex_grow="1" style_translate_y="2"/></lv_obj></lv_obj></lv_obj></view></component>
