<?xml version="1.0"?><component><api><prop name="thumbnail_src" type="string"/><prop name="filename" type="string"/><prop name="print_time" type="string"/><prop name="filament_weight" type="string"/></api><consts><px name="metadata_top_pad" value="4"/><px name="icon_text_gap" value="3"/><px name="card_base_width" value="170"/><px name="card_min_width" value="130"/><px name="card_max_width" value="230"/><px name="card_height" value="245"/><int name="metadata_overlay_opacity" value="160"/><px name="thumbnail_height" value="150"/></consts><view name="card_root"
        extends="ui_card" height="#card_height" style_flex_basis="#card_base_width" flex_grow="1"
        style_min_width="#card_min_width" style_max_width="#card_max_width" style_pad_all="0" style_border_width="0"
        style_radius="#border_radius" clickable="true"><lv_image name="gradient_bg" width="100%" height="100%" inner_align="stretch"/><lv_image name="thumbnail" src="$thumbnail_src" align="center" style_translate_y="#preview_offset_y"/><icon name="no_thumbnail_icon"
