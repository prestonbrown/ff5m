            style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"><bind_flag_if_eq subject="wifi_connecting" flag="hidden" ref_value="0"/><spinner size="lg" align="center"/><text_muted text="Connecting..." translation_tag="Connecting..." style_margin_top="#space_md" align="center"/></lv_obj><divider_horizontal/><lv_obj width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row"><ui_button name="modal_cancel_btn"
