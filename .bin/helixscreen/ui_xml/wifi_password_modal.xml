<?xml version="1.0"?><component><view name="wifi_password_modal"
        extends="ui_dialog" width="70%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0"><lv_obj name="password_form_container"
            width="100%" height="content" style_min_height="200" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_md"><bind_flag_if_eq subject="wifi_connecting" flag="hidden" ref_value="1"/><text_heading name="modal_title"
                    width="100%" text="Enter WiFi Password" translation_tag="Enter WiFi Password"
                    style_text_align="center"/><text_small name="modal_ssid"
                  width="100%" bind_text="wifi_password_modal_ssid" style_text_align="center"
                  style_text_color="#text_muted"/><lv_obj width="100%"
