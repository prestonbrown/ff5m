<?xml version="1.0"?><component><api><prop name="icon_name" type="string" default="info"/><prop name="title" type="string" default=""/><prop name="message" type="string" default=""/><prop name="url_text" type="string" default=""/></api><view name="info_qr_modal"
        extends="ui_dialog" width="75%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0"><lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_md"><lv_obj width="100%"
