<?xml version="1.0"?><component><view name="bed_mesh_calibrate_modal"
        extends="ui_dialog" width="75%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0"><lv_obj name="probing_container"
            width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_flex_main_place="start" style_flex_track_place="center" style_pad_gap="#space_md" hidden="true"><bind_flag_if_not_eq subject="bed_mesh_calibrate_state" flag="hidden" ref_value="1"/><text_heading width="100%" text="Probing Bed Mesh" translation_tag="Probing Bed Mesh" style_text_align="center"/><text_muted name="probe_progress_text"
                  width="100%" bind_text="bed_mesh_probe_text" text="Initializing..." translation_tag="Initializing..."
                  style_text_align="center"/><progress_bar name="probe_progress_bar" width="90%" bind_value="bed_mesh_probe_progress"><bind_flag_if_eq subject="bed_mesh_probe_indeterminate" flag="hidden" ref_value="1"/></progress_bar><spinner size="md"><bind_flag_if_eq subject="bed_mesh_probe_indeterminate" flag="hidden" ref_value="0"/></spinner></lv_obj><lv_obj name="naming_container"
            width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_flex_main_place="start" style_flex_track_place="center" style_pad_gap="#space_md" hidden="true"><bind_flag_if_not_eq subject="bed_mesh_calibrate_state" flag="hidden" ref_value="2"/><icon src="check_circle" size="lg" variant="success"/><text_heading width="100%" text="Mesh Complete" translation_tag="Mesh Complete" style_text_align="center"/><text_small width="100%"
                  text="Enter a name to save this profile" translation_tag="Enter a name to save this profile"
                  style_text_align="center"/><text_input name="calibrate_profile_name_input"
                  width="100%" height="#input_height" placeholder_text="Profile name (e.g., default)"
                  placeholder_tag="Profile name (e.g., default)" translation_tag="Profile name (e.g., default)"
                  style_margin_top="#space_xs"/></lv_obj><lv_obj name="error_container"
            width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_flex_main_place="start" style_flex_track_place="center" style_pad_gap="#space_md" hidden="true"><bind_flag_if_not_eq subject="bed_mesh_calibrate_state" flag="hidden" ref_value="3"/><icon src="alert_circle" size="lg" variant="danger"/><text_heading width="100%"
                    text="Calibration Failed" translation_tag="Calibration Failed" style_text_align="center"/><text_muted name="error_message_label"
                  width="100%" bind_text="bed_mesh_error_message" text="An error occurred during calibration."
                  translation_tag="An error occurred during calibration." long_mode="wrap" style_text_align="center"/></lv_obj><divider_horizontal/><lv_obj name="probing_button_row"
            width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row" hidden="true"
            scrollable="false"><bind_flag_if_not_eq subject="bed_mesh_calibrate_state" flag="hidden" ref_value="1"/><ui_button name="btn_emergency_stop"
                 height="100%" flex_grow="1" style_radius="0" variant="danger" icon="alert_octagon"
                 text="EMERGENCY STOP" translation_tag="EMERGENCY STOP"><event_cb trigger="clicked" callback="on_bed_mesh_emergency_stop"/></ui_button></lv_obj><text_small width="100%"
                text="Stops all motion. Requires firmware restart."
                translation_tag="Stops all motion. Requires firmware restart." style_text_align="center"
                style_pad_top="#space_sm" style_pad_bottom="#space_sm" hidden="true"><bind_flag_if_not_eq subject="bed_mesh_calibrate_state" flag="hidden" ref_value="1"/></text_small><lv_obj name="naming_button_row"
            width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row" hidden="true"
            scrollable="false"><bind_flag_if_not_eq subject="bed_mesh_calibrate_state" flag="hidden" ref_value="2"/><ui_button name="btn_dont_save"
                 height="100%" flex_grow="1" style_radius="0" text="Don't Save" translation_tag="Don't Save"><event_cb trigger="clicked" callback="on_bed_mesh_calibrate_cancel"/></ui_button><divider_vertical/><ui_button name="btn_save" height="100%" flex_grow="1" style_radius="0" text="Save" translation_tag="Save"><event_cb trigger="clicked" callback="on_bed_mesh_save_profile"/></ui_button></lv_obj><lv_obj name="error_button_row"
            width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row" hidden="true"
            scrollable="false"><bind_flag_if_not_eq subject="bed_mesh_calibrate_state" flag="hidden" ref_value="3"/><ui_button name="btn_close" height="100%" flex_grow="1" style_radius="0" text="Close" translation_tag="Close"><event_cb trigger="clicked" callback="on_bed_mesh_calibrate_cancel"/></ui_button></lv_obj></view></component>
