<?xml version="1.0"?><component><view name="macro_enhance_modal"
        extends="ui_dialog" width="90%" height="content" align="center" style_max_height="85%" flex_flow="column"
        style_flex_main_place="start" style_pad_gap="0"><lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_sm" flex_flow="row" style_flex_main_place="space_between"
            style_flex_cross_place="center"><text_heading name="step_title" bind_text="macro_enhance_step_title"/><text_small name="step_progress" bind_text="macro_enhance_step_progress"/></lv_obj><lv_obj name="operation_container"
            width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_sm" style_pad_bottom="#space_lg" flex_flow="column" style_pad_gap="#space_md"><bind_flag_if_eq subject="macro_enhance_show_operation" flag="hidden" ref_value="0"/><text_body name="operation_description" width="100%" bind_text="macro_enhance_description" long_mode="wrap"/></lv_obj><lv_obj name="summary_container"
            width="100%" height="content" hidden="true" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_sm" style_pad_bottom="#space_lg" flex_flow="column" style_pad_gap="#space_md"><bind_flag_if_eq subject="macro_enhance_show_summary" flag="hidden" ref_value="0"/><lv_obj width="100%"
              height="content" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_sm"
              style_pad_all="0"><icon src="check_circle_outline" size="lg" variant="success"/><text_body text="Review your changes" translation_tag="Review your changes" style_text_align="center"/></lv_obj><lv_obj width="100%"
              height="content" style_max_height="180" style_bg_color="#screen_bg" style_bg_opa="255"
              style_border_width="1" style_border_color="#text_muted" style_border_opa="64"
              style_radius="#border_radius" style_pad_all="#space_md" scrollable="true" scroll_snap_y="none"><lv_label name="summary_list"
                  width="100%" bind_text="macro_enhance_summary" long_mode="wrap" style_text_font="#font_small"/></lv_obj><lv_obj width="100%"
              height="content" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
              style_pad_all="0" style_pad_gap="#space_xs"><lv_checkbox name="backup_checkbox" checked="true" text=""/><text_body name="backup_label" bind_text="macro_enhance_backup_text"/></lv_obj><lv_obj width="100%"
              height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
              style_pad_all="0"><icon src="alert" size="sm" variant="warning"/><text_small width="content"
                    text="Klipper will restart to apply changes" translation_tag="Klipper will restart to apply changes"
                    style_text_color="#warning"/></lv_obj></lv_obj><lv_obj name="applying_container"
            width="100%" height="content" hidden="true" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_xl" style_pad_bottom="#space_xl" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_lg"><bind_flag_if_eq subject="macro_enhance_show_applying" flag="hidden" ref_value="0"/><spinner size="lg"/><text_body name="applying_status" bind_text="macro_enhance_description" style_text_align="center"/></lv_obj><lv_obj name="success_container"
            width="100%" height="content" hidden="true" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_xl" style_pad_bottom="#space_xl" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_md"><bind_flag_if_eq subject="macro_enhance_show_success" flag="hidden" ref_value="0"/><icon src="check_circle" size="xl" variant="success"/><text_heading text="Enhancement Complete!" translation_tag="Enhancement Complete!" style_text_align="center"/><text_body name="success_message"
                 width="100%" bind_text="macro_enhance_description" long_mode="wrap" style_text_align="center"/></lv_obj><lv_obj name="error_container"
            width="100%" height="content" hidden="true" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_xl" style_pad_bottom="#space_xl" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_md"><bind_flag_if_eq subject="macro_enhance_show_error" flag="hidden" ref_value="0"/><icon src="alert_circle" size="xl" variant="danger"/><text_heading text="Enhancement Failed" translation_tag="Enhancement Failed" style_text_align="center"/><text_body name="error_message"
                 width="100%" bind_text="macro_enhance_description" long_mode="wrap" style_text_align="center"/></lv_obj><divider_horizontal/><lv_obj name="operation_buttons"
            width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row"><bind_flag_if_eq subject="macro_enhance_show_operation" flag="hidden" ref_value="0"/><ui_button name="btn_skip"
                 height="100%" text="Keep Required" translation_tag="Keep Required" flex_grow="1" style_radius="0"><event_cb trigger="clicked" callback="on_macro_enhance_skip"/></ui_button><divider_vertical/><ui_button name="btn_approve"
                 height="100%" text="Make Optional" translation_tag="Make Optional" variant="success" flex_grow="1"
                 style_radius="0"><event_cb trigger="clicked" callback="on_macro_enhance_approve"/></ui_button></lv_obj><lv_obj name="summary_buttons"
            width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row" hidden="true"><bind_flag_if_eq subject="macro_enhance_show_summary" flag="hidden" ref_value="0"/><ui_button name="btn_cancel" height="100%" text="Cancel" translation_tag="Cancel" flex_grow="1" style_radius="0"><event_cb trigger="clicked" callback="on_macro_enhance_cancel"/></ui_button><divider_vertical/><ui_button name="btn_apply"
                 height="100%" text="Apply Changes" translation_tag="Apply Changes" variant="success" flex_grow="1"
                 style_radius="0"><event_cb trigger="clicked" callback="on_macro_enhance_apply"/></ui_button></lv_obj><lv_obj name="applying_buttons"
            width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row" hidden="true"><bind_flag_if_eq subject="macro_enhance_show_applying" flag="hidden" ref_value="0"/><ui_button name="btn_applying"
                 height="100%" text="Applying..." translation_tag="Applying..." flex_grow="1" clickable="false"
                 style_radius="0" style_bg_opa="128"/></lv_obj><lv_obj name="close_buttons"
            width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row" hidden="true"><ui_button name="btn_close" height="100%" text="Close" translation_tag="Close" flex_grow="1" style_radius="0"><event_cb trigger="clicked" callback="on_macro_enhance_close"/></ui_button></lv_obj></view></component>
