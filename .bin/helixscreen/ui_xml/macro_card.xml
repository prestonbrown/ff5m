<?xml version="1.0"?><component><api><prop name="name_subject" type="string" default=""/><prop name="desc_subject" type="string" default=""/><prop name="visible_subject" type="string" default=""/><prop name="desc_hidden_subject" type="string" default=""/><prop name="chevron_hidden_subject" type="string" default=""/><prop name="row_index" type="string" default=""/></api><view name="macro_card"
