#
# HelixScreen runtime configuration - AD5X Forge-X rig
#
# Read by bin/helix-launcher.sh at start; a variable already present in the
# environment wins over a line here. Log destination, log file and cache dir
# are set by platform/hooks.sh (platform_pre_start); Moonraker is NOT an env
# var - the app reads printer.moonraker_host from settings.json (seeded from
# config/settings.json on first boot, default 127.0.0.1:7125 = this rig's
# Moonraker in the chroot).

# Remote control server (helix-screen ctl). Dev rig: on. The binary must be
# built with ENABLE_REMOTE_CONTROL=yes or this line buys nothing.
HELIX_REMOTE_CONTROL=1
HELIX_REMOTE_SOCKET=/tmp/helixscreen-control.sock

# Log level: info | debug | trace. debug while bringing the rig up, info once
# it is boring.
HELIX_LOG_LEVEL=info

# Durable UI state outside the payload, so a payload redeploy never resets
# the UI's settings. Seeded from this payload's config/settings.json on the
# first start (see .shell/helixscreen.sh seed_config).
HELIX_CONFIG_DIR=/opt/config/mod_data/helixscreen/config
